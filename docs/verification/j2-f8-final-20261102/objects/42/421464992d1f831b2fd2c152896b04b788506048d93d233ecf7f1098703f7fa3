#!/usr/bin/env python3
"""Generate offline GUI solid definitions from compiled E7 Describe(), never a second table."""
from __future__ import annotations
import argparse
import hashlib
import json
from pathlib import Path
import subprocess

ROOT = Path(__file__).resolve().parents[1]
OUTPUT = ROOT / 'gui/g4usim_gui/core/solid_registry_data.py'
SOURCES = ('include/Geometry/SolidRegistry.hh', 'src/Geometry/SolidRegistry.cc',
           'include/Geometry/GeometryTypes.hh')


def definition_hashes():
    return {name: hashlib.sha256((ROOT / name).read_bytes()).hexdigest() for name in SOURCES}


def render(metadata):
    if metadata.get('schema') != 'g4usim_solid_registry_v1':
        raise ValueError('Unsupported SolidRegistry schema')
    return ('# Generated by scripts/generate_solid_registry.py; do not edit.\n'
            '# Data comes from compiled SolidRegistry::Describe(); hash binds its source definitions.\n'
            'from __future__ import annotations\nimport json\n\n'
            'SOURCE_SHA256 = ' + repr(definition_hashes()) + '\n'
            "REGISTRY = json.loads(r'''" + json.dumps(metadata, ensure_ascii=False, indent=2, sort_keys=True) + "''')\n\n"
            'SOLIDS = {entry["name"]: entry for entry in REGISTRY["solids"]}\n'
            'ALIASES = {alias: entry["name"] for entry in REGISTRY["solids"]\n'
            '           for alias in [entry["name"], *entry["aliases"]]}\n\n'
            'def canonical_solid(name: str) -> str:\n'
            '    return ALIASES.get(name.strip().lower(), name.strip().lower())\n\n'
            'def solid_spec(name: str) -> dict | None:\n'
            '    return SOLIDS.get(canonical_solid(name))\n\n'
            'def property_keys(name: str) -> tuple[str, ...]:\n'
            '    return tuple(field["name"] for field in (solid_spec(name) or {}).get("properties", []))\n')


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--check', action='store_true')
    parser.add_argument('--executable', type=Path, help='fresh real backend; defaults to standalone C++ component')
    parser.add_argument('--output', type=Path, default=OUTPUT)
    args = parser.parse_args()
    if args.executable:
        from run_m0_tests import workspace_source_fingerprint
        exe = args.executable.resolve()
        reply = subprocess.run([str(exe), '--capabilities'], cwd=exe.parent, capture_output=True,
                               text=True, encoding='utf-8', errors='replace', timeout=30, check=True)
        capabilities = json.loads(reply.stdout)
        if capabilities.get('source_fingerprint') != workspace_source_fingerprint():
            raise ValueError('Backend source fingerprint differs from current worktree')
        metadata = capabilities['solid_registry']
    else:
        from test_solid_registry import component
        metadata = component()
    text = render(metadata)
    if args.check:
        if not args.output.is_file() or args.output.read_text(encoding='utf-8') != text:
            raise SystemExit('Stale offline SolidRegistry data; run scripts/generate_solid_registry.py')
        print('offline SolidRegistry data: current compiled metadata/source hashes match')
    else:
        args.output.write_text(text, encoding='utf-8', newline='\n')
        print('generated ' + str(args.output))


if __name__ == '__main__':
    main()
