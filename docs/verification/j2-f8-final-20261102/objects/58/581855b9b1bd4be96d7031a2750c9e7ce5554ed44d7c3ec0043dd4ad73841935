        {
          "path": ".geometryEditor.raw_source_text",
          "before": "",
          "after": "# ============================================================\n# 复杂实验装置几何模型 (hierarchical 模板)\n# 包含：球形靶、圆柱屏蔽层、双层探测器环、梯形支架、冷却管\n# ============================================================\n\n# -------------------- 世界体积 --------------------\n[world]\nshape = box\nsize = 80 cm, 80 cm, 80 cm\nmaterial = G4_AIR\nvis.color = white\nvis.alpha = 0.05\nvis.visible = true\nvis.wireframe = true\n\n# -------------------- 主腔体（铝） --------------------\n[volume.main_chamber]\nparent = world\nshape = box\nsize = 50 cm, 50 cm, 50 cm\nmaterial = G4_Al\nposition = 0 mm, 0 mm, 0 mm\nrotation = 0 deg, 0 deg, 0 deg\nvis.color = gray\nvis.alpha = 0.10\nvis.visible = true\nvis.wireframe = true\n\n# -------------------- 中心球形铅靶 --------------------\n[volume.target_sphere]\nparent = main_chamber\nshape = sphere\nparameters = 0 mm, 2 cm, 0 deg, 360 deg, 0 deg, 180 deg\nmaterial = G4_Pb\nposition = 0 mm, 0 mm, 0 mm\nvis.color = red\nvis.alpha = 0.70\nvis.visible = true\nvis.wireframe = false\n# 靶本身不设为敏感，但可用于能量沉积 scoring\n\n# -------------------- 内层水慢化层（圆柱） --------------------\n[volume.water_moderator]\nparent = main_chamber\nshape = tubs\nparameters = 2.1 cm, 3.5 cm, 5 cm, 0 deg, 360 deg\nmaterial = G4_WATER\nposition = 0 mm, 0 mm, 0 mm\nvis.color = blue\nvis.alpha = 0.30\nvis.visible = true\nvis.wireframe = false\n\n# -------------------- 外层铅屏蔽层（圆柱） --------------------\n[volume.lead_shield]\nparent = main_chamber\nshape = tubs\nparameters = 3.6 cm, 5 cm, 6 cm, 0 deg, 360 deg\nmaterial = G4_Pb\nposition = 0 mm, 0 mm, 0 mm\nbias = true\nregion = ShieldRegion\nvis.color = darkgray\nvis.alpha = 0.50\nvis.visible = true\nvis.wireframe = false\n\n# -------------------- 内层探测器环（4个） --------------------\n# 探测器1: +X方向\n[volume.inner_detector_x]\nparent = main_chamber\nshape = box\nsize = 2.5 cm, 2.5 cm, 0.4 cm\nmaterial = silicon\nposition = 7 cm, 0 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = InnerDetRegion\ncut.gamma = 0.5 mm\ncut.e- = 50 um\ncut.e+ = 50 um\ncopyNo = 101\nvis.color = cyan\nvis.alpha = 0.80\nvis.visible = true\nvis.wireframe = false\n\n# 探测器2: -X方向\n[volume.inner_detector_nx]\nparent = main_chamber\nshape = box\nsize = 2.5 cm, 2.5 cm, 0.4 cm\nmaterial = silicon\nposition = -7 cm, 0 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = InnerDetRegion\ncut.gamma = 0.5 mm\ncut.e- = 50 um\ncut.e+ = 50 um\ncopyNo = 102\nvis.color = cyan\nvis.alpha = 0.80\nvis.visible = true\nvis.wireframe = false\n\n# 探测器3: +Y方向\n[volume.inner_detector_y]\nparent = main_chamber\nshape = box\nsize = 2.5 cm, 2.5 cm, 0.4 cm\nmaterial = silicon\nposition = 0 cm, 7 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = InnerDetRegion\ncut.gamma = 0.5 mm\ncut.e- = 50 um\ncut.e+ = 50 um\ncopyNo = 103\nvis.color = cyan\nvis.alpha = 0.80\nvis.visible = true\nvis.wireframe = false\n\n# 探测器4: -Y方向\n[volume.inner_detector_ny]\nparent = main_chamber\nshape = box\nsize = 2.5 cm, 2.5 cm, 0.4 cm\nmaterial = silicon\nposition = 0 cm, -7 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = InnerDetRegion\ncut.gamma = 0.5 mm\ncut.e- = 50 um\ncut.e+ = 50 um\ncopyNo = 104\nvis.color = cyan\nvis.alpha = 0.80\nvis.visible = true\nvis.wireframe = false\n\n# -------------------- 外层探测器环（4个，更大尺寸） --------------------\n# 探测器5: +X 方向外圈\n[volume.outer_detector_x]\nparent = main_chamber\nshape = box\nsize = 4 cm, 4 cm, 0.5 cm\nmaterial = silicon\nposition = 12 cm, 0 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = OuterDetRegion\ncut.gamma = 1 mm\ncut.e- = 0.2 mm\ncut.e+ = 0.2 mm\ncopyNo = 201\nvis.color = lime\nvis.alpha = 0.70\nvis.visible = true\nvis.wireframe = false\n\n[volume.outer_detector_nx]\nparent = main_chamber\nshape = box\nsize = 4 cm, 4 cm, 0.5 cm\nmaterial = silicon\nposition = -12 cm, 0 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = OuterDetRegion\ncut.gamma = 1 mm\ncut.e- = 0.2 mm\ncut.e+ = 0.2 mm\ncopyNo = 202\nvis.color = lime\nvis.alpha = 0.70\nvis.visible = true\nvis.wireframe = false\n\n[volume.outer_detector_y]\nparent = main_chamber\nshape = box\nsize = 4 cm, 4 cm, 0.5 cm\nmaterial = silicon\nposition = 0 cm, 12 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = OuterDetRegion\ncut.gamma = 1 mm\ncut.e- = 0.2 mm\ncut.e+ = 0.2 mm\ncopyNo = 203\nvis.color = lime\nvis.alpha = 0.70\nvis.visible = true\nvis.wireframe = false\n\n[volume.outer_detector_ny]\nparent = main_chamber\nshape = box\nsize = 4 cm, 4 cm, 0.5 cm\nmaterial = silicon\nposition = 0 cm, -12 cm, 0 cm\nrotation = 0 deg, 0 deg, 0 deg\nsensitive = true\nregion = OuterDetRegion\ncut.gamma = 1 mm\ncut.e- = 0.2 mm\ncut.e+ = 0.2 mm\ncopyNo = 204\nvis.color = lime\nvis.alpha = 0.70\nvis.visible = true\nvis.wireframe = false\n\n# -------------------- 梯形铁支架（TRD形状） --------------------\n# 放置在主腔体底部，支撑靶区\n[volume.iron_stand]\nparent = main_chamber\nshape = trd\ndx1 = 8 cm       # 下底面 x 半长\ndx2 = 10 cm      # 上底面 x 半长\ndy1 = 8 cm       # 下底面 y 半长\ndy2 = 10 cm      # 上底面 y 半长\ndz = 2 cm        # z 方向半长\nmaterial = iron\nposition = 0 cm, 0 cm, -18 cm    # 置于腔体底部\nrotation = 0 deg, 0 deg, 0 deg\nvis.color = brown\nvis.alpha = 0.60\nvis.visible = true\nvis.wireframe = false\n\n# -------------------- 冷却水管（圆柱，穿过腔体） --------------------\n[volume.cooling_pipe]\nparent = main_chamber\nshape = tubs\nparameters = 0 cm, 0.8 cm, 20 cm, 0 deg, 360 deg\nmaterial = water\nposition = 9 cm, 15 cm, 0 cm\nrotation = 0 deg, 45 deg, 0 deg    # 倾斜45度增加复杂性\nvis.color = aqua\nvis.alpha = 0.50\nvis.visible = true\nvis.wireframe = false\n"
