    {
      "old": "geometry.vector.components (box size)",
      "new": "geometry.solid.size",
      "when": "box size malformed",
      "location": "geometry/volumes/<row>/size",
      "action": "Main explicitly accepted only this box-size machine-code migration; field size unchanged, new code changes new-record identity"
    },
    {
      "old": "geometry.trd.length",
      "new": [
        "geometry.solid.dx1",
        "geometry.solid.dx2",
        "geometry.solid.dy1",
        "geometry.solid.dy2",
        "geometry.solid.dz"
      ],
      "when": "missing required trd properties",
      "location": "geometry/volumes/<row>/<property>",
      "action": "Main explicitly accepted registry per-property code split and new detail locations; no alias or historical JSON rewrite"
    },
    {
      "old": "geometry.layer.alpha_range",
      "new": "geometry.layer.alpha_range",
      "when": "layer vis.alpha out of range",
      "location": "layers/layers/<row>/vis.alpha",
      "action": "same code; now an editable backend-details field, remove old unsupported location expectation"
    },
    {
      "old": "geometry.metadata.syntax",
      "new": "geometry.metadata.syntax",
      "when": "invalid metadata syntax",
      "location": "layers/layers/<row>/metadata",
      "action": "same code; editable metadata details field"
    },
    {
      "old": "geometry.visual.alpha_range",
      "new": "geometry.visual.alpha_range",
      "when": "volume vis.alpha out of range",
      "location": "geometry/volumes/<row>/vis.alpha",
      "action": "same code; editable backend-details field"
    }
