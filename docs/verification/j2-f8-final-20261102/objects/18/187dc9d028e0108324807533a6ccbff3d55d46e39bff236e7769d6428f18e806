  "registry_code_decision": {
    "accepted_by_main": true,
    "scope": [
      "box size: geometry.vector.components -> geometry.solid.size",
      "trd required lengths: geometry.trd.length -> geometry.solid.dx1/dx2/dy1/dy2/dz"
