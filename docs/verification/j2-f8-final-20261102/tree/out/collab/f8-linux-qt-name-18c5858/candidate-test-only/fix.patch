+def _assert_history_provider(interface, control, text_label, expected):
+    """Check real Qt naming semantics and the actual accessible label object.
+
+    Qt 6.11 QAccessibleComboBox::text uses currentText for Name on Unix;
+    the semantic label is exposed through the Label relation. Windows uses
+    the widget Name. Keep both paths strict, never fall back to property-only.
+    https://github.com/qt/qtbase/blob/v6.11.3/src/widgets/accessible/complexwidgets.cpp#L381
+    """
+    from PySide6.QtGui import QAccessible
+    from PySide6.QtWidgets import QComboBox
+    assert interface.object() is control
+    labels = [target for target, flags in interface.relations(QAccessible.Label)
+              if flags & QAccessible.Label and target.object() is text_label]
+    assert labels, ('missing actual Label relation', type(control).__name__, expected)
+    label_interface = labels[0]
+    assert label_interface.role() == QAccessible.StaticText
+    assert label_interface.text(QAccessible.Name) == expected
+    actual_name = interface.text(QAccessible.Name)
+    if isinstance(control, QComboBox):
+        assert interface.role() == QAccessible.ComboBox
+        assert interface.text(QAccessible.Value) == control.currentText()
+        expected_name = (control.currentText() or expected) if sys.platform.startswith('linux') else expected
+        assert actual_name == expected_name, (sys.platform, actual_name, expected_name)
+    else:
+        assert interface.role() == QAccessible.EditableText
+        assert actual_name == expected
+    return {'qt_label_name': label_interface.text(QAccessible.Name),
+            'qt_label_role': str(label_interface.role()),
+            'qt_label_object_matches': label_interface.object() is text_label}
+
