<gdml xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://service-spi.web.cern.ch/service-spi/app/releases/GDML/schema/gdml.xsd">
  <materials>
    <material name="Water" Z="1">
      <D value="1.0" unit="g/cm3" />
      <atom value="1.008" />
    </material>
    <material name="Vacuum" Z="1">
      <D value="1e-25" unit="g/cm3" />
      <atom value="1.008" />
    </material>
  <material name="Dense" Z="1">
      <D value="2" unit="g/cm3" />
      <atom value="1.008" />
    </material></materials>
  <solids>
    <box name="WorldBox" x="1000" y="1000" z="1000" lunit="mm" />
    <box name="DetBox" x="20" y="20" z="20" lunit="mm" />
  <box name="SmallBox" x="10" y="20" z="20" lunit="mm" /><box name="ContainerBox" x="40" y="40" z="40" lunit="mm" /></solids>
  <structure>
    <volume name="SensorA">
      <materialref ref="Water" />
      <solidref ref="DetBox" />
      <auxiliary auxtype="SensDet" auxvalue="Detector" />
    </volume>
    <volume name="SensorB">
      <materialref ref="Dense" />
      <solidref ref="SmallBox" />
      <auxiliary auxtype="SensDet" auxvalue="Detector" />
    </volume><volume name="Container0"><materialref ref="Vacuum" /><solidref ref="ContainerBox" /><physvol name="SamePV" copynumber="0"><volumeref ref="SensorA" /><position name="SensorPos0" x="0" y="0" z="0" unit="mm" /></physvol></volume><volume name="Container1"><materialref ref="Vacuum" /><solidref ref="ContainerBox" /><physvol name="SamePV" copynumber="0"><volumeref ref="SensorB" /><position name="SensorPos1" x="0" y="0" z="0" unit="mm" /></physvol></volume><volume name="World_LV">
      <materialref ref="Vacuum" />
      <solidref ref="WorldBox" />
      <physvol name="Parent0" copynumber="0"><volumeref ref="Container0" /><position name="ParentPos0" x="-30" y="0" z="100" unit="mm" /></physvol><physvol name="Parent1" copynumber="0"><volumeref ref="Container1" /><position name="ParentPos1" x="30" y="0" z="100" unit="mm" /></physvol></volume>
  </structure>
  <setup name="Default" version="1.0">
    <world ref="World_LV" />
  </setup>
</gdml>