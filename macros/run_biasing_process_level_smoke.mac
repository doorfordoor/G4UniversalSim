# Process-level XS biasing smoke test.
# This validates initialization/operator attachment/output wiring only.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/AIHL/material/load config/materials/material.ini

/AIHL/geometry/setTemplate simple_box
/AIHL/geometry/loadConfig config/geometry/hit_smoke_box.ini
/AIHL/geometry/checkOverlaps true
/AIHL/geometry/printTree

/AIHL/physics/setReferenceList FTFP_BERT_EMZ
/AIHL/physics/setDefaultCut 1 um
/AIHL/physics/enableBiasing true

/AIHL/source/particle e-
/AIHL/source/energy 1 MeV
/AIHL/source/point 0 0 -9 mm
/AIHL/source/direction 0 0 1

/AIHL/scoring/enable true
/AIHL/scoring/hits true
/AIHL/scoring/eventEdep true
/AIHL/scoring/edep true
/AIHL/scoring/autoCreateScorers true
/AIHL/scoring/setEdepHistogram bins=100 min=0 eV max=1 MeV
/AIHL/scoring/setWeightedEdepHistogram bins=100 min=0 eV max=1 MeV

/AIHL/biasing/enable true
/AIHL/biasing/xs/addRule e- eIoni
/AIHL/biasing/xs/setRuleFactor e- eIoni 2.0
/AIHL/biasing/xs/addRuleVolume e- eIoni Target
/AIHL/biasing/xs/setRuleOnlyPrimary e- eIoni false
/AIHL/biasing/xs/setRuleApplyToSecondaries e- eIoni true
/AIHL/biasing/xs/setRuleMinWeight e- eIoni 0.05
/AIHL/biasing/xs/setRuleMaxInteractions e- eIoni 5
/AIHL/biasing/print

/run/initialize
/run/beamOn 20
