# Round 6D boolean union smoke: two overlapping boxes.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/AIHL/material/load config/materials/material.ini

/AIHL/geometry/setTemplate hierarchical
/AIHL/geometry/loadConfig config/geometry/boolean_union_two_boxes.ini
/AIHL/geometry/checkOverlaps true
/AIHL/geometry/printTree

/AIHL/physics/setReferenceList FTFP_BERT_EMZ
/AIHL/physics/setDefaultCut 1 um

/run/initialize
/AIHL/detector/printRegistry
/AIHL/detector/printSensitiveVolumes
/AIHL/detector/printBiasVolumes
