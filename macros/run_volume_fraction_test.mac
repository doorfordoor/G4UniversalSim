# volume_fraction material backend smoke test.

/control/verbose 1
/run/verbose 1
/event/verbose 0
/tracking/verbose 0

/AIHL/material/load config/materials/volume_fraction_test.ini
/AIHL/material/print

/AIHL/geometry/setTemplate simple_box
/AIHL/geometry/loadConfig config/geometry/volume_fraction_box.ini
/AIHL/geometry/checkOverlaps true
/AIHL/geometry/printTree

/AIHL/physics/setReferenceList FTFP_BERT_EMZ
/AIHL/physics/setDefaultCut 1 um

/AIHL/source/particle e-
/AIHL/source/energy 1 MeV
/AIHL/source/point 0 0 -4 mm
/AIHL/source/direction 0 0 1

/AIHL/scoring/enable true
/AIHL/scoring/eventEdep true
/AIHL/scoring/edep true
/AIHL/scoring/setEdepHistogram bins=50 min=0 eV max=1 MeV
/AIHL/scoring/setWeightedEdepHistogram bins=50 min=0 eV max=1 MeV

/run/initialize
/run/beamOn 10
