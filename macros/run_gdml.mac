# Parser-only GDML placeholder demo.
#
# Current status:
# - GDML import is only a placeholder in GDMLTemplate.
# - G4GDMLParser is not wired into DetectorConstruction or VolumeBuilder yet.
# - Do NOT execute /run/initialize for this macro.
# - This file is intentionally limited to loading and printing the placeholder
#   configuration so users do not accidentally run an unsupported geometry.

/control/verbose 1
/run/verbose 1

/AIHL/material/load config/materials/material.ini
/AIHL/geometry/setTemplate gdml
/AIHL/geometry/loadConfig config/geometry/gdml_import.ini
/AIHL/geometry/print
/AIHL/geometry/printTree

# GDMLTemplate is currently a placeholder only. Do not call /run/initialize
# for this macro until VolumeBuilder gains real GDML import support.
# /run/initialize
# /control/execute macros\vis.mac
